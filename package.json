{
  "name": "aster-project-atl",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@aster/web --",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@aster/web --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=@aster/web",
    "seed:airtable": "node --env-file=.env --import tsx scripts/seed-airtable-demo.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
