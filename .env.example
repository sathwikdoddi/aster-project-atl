# Copy to .env at the repository root. Never commit an actual token.
CONTENT_SOURCE=mock
AIRTABLE_API=
AIRTABLE_BASE_ID=
AIRTABLE_CASES_TABLE=Cases
# Set CONTENT_SOURCE=airtable-demo to read only the two seeded fictional cases.

# Owner dashboard and approved public snapshots. See docs/admin-setup.md.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ADMIN_AIRTABLE_BASE_ID=
ADMIN_AIRTABLE_PROFILES_TABLE=Family Profiles
PUBLIC_SITE_URL=http://127.0.0.1:3000
PUBLICATION_STORE=supabase
# After SQL setup, set CONTENT_SOURCE=published for approved snapshots.
# For a fictional development-only owner UI, run ADMIN_MODE=demo npm run dev:admin.
